# =============================================================================
# Configuration RAG-time / LogiStore
# Copier ce fichier en .env et remplir les valeurs sensibles
# =============================================================================

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=tickets_support

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu  # cpu | cuda | mps

# --- Reranker (optionnel) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

# --- OpenRouter (LLM synthèse) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet
# Alternatives : mistralai/mistral-large, meta-llama/llama-3.3-70b-instruct

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-production
LOG_LEVEL=INFO

# --- Dataset ---
DATASET_NAME=mirzayasirabdullah07/customer-support-tickets-dataset-200k-records
DATASET_PATH=data/raw/customer_support_tickets.csv
# Pour le MVP : limiter à un sous-échantillon
DATASET_SAMPLE_SIZE=10000

# --- Recherche ---
HYBRID_TOP_K_RETRIEVE=50      # candidats avant rerank
HYBRID_TOP_K_FINAL=10         # résultats finaux
RRF_K=60                       # paramètre RRF

# --- Évaluation ---
EVAL_GOLDEN_PATH=data/golden/queries.json
EVAL_JUDGE_MODEL=anthropic/claude-3.5-sonnet
EVAL_OUTPUT_DIR=data/evaluation
